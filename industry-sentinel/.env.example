# ── Firebase ──────────────────────────────────────────────────────────────────
# Copy to .env and fill in from Firebase Console → Project settings → Your apps.
#
# Leave VITE_FIREBASE_API_KEY empty and the console runs unconfigured: open
# demo login, generated data, and a "Datos simulados" badge on every view. It
# never silently presents generated numbers as measurement.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
