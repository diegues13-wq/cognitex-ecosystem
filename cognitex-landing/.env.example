# GA4 measurement id. When unset, no analytics script loads and the LOPDP
# consent banner never appears — the site simply has no analytics.
# PUBLIC_ prefix is required for Astro to expose it to the client.
PUBLIC_GA4_MEASUREMENT_ID=

# ── Not used yet ─────────────────────────────────────────────────────────────
# The chat (Vertex AI), the live-demo feed and the coverage map all run
# server-side per spec §3 and land with the Cloud Run backend. No API key
# belongs in this file: anything prefixed PUBLIC_ ships inside the JS bundle.
