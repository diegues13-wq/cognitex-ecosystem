---
import { SITE, PLATFORMS, whatsappLink } from '~/config';
import { route, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const columns = [
    {
        title: t.footer.engines,
        links: [
            { href: route('energia', locale), label: t.nav.energia },
            { href: route('agentes', locale), label: t.nav.agentes },
            { href: route('flotas', locale), label: t.nav.flotas },
            { href: route('demo', locale), label: t.nav.demo },
        ],
    },
    {
        title: t.footer.company,
        links: [
            { href: route('nosotros', locale), label: t.nav.nosotros },
            { href: route('casos', locale), label: t.nav.casos },
            { href: route('contacto', locale), label: t.nav.contacto },
        ],
    },
];
---

<footer class="border-t border-white/8 bg-navy-deep">
    <div class="container-page py-16">
        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
            <div class="lg:col-span-1">
                <p class="font-display text-lg font-semibold">
                    COGNITEX <span class="text-cyan-electric">INDUSTRIAL</span>
                </p>
                <p class="mt-3 max-w-xs text-sm leading-relaxed text-steel">
                    {t.footer.tagline}
                </p>
                <p class="mt-5 flex items-center gap-2 text-sm text-steel">
                    <span class="inline-block size-2 rounded-full bg-green-ok" aria-hidden="true"
                    ></span>
                    {t.footer.location}
                </p>
            </div>

            {
                columns.map((column) => (
                    <nav aria-label={column.title}>
                        <h2 class="font-display text-xs font-semibold tracking-[0.18em] uppercase text-cyan-electric">
                            {column.title}
                        </h2>
                        <ul class="mt-5 space-y-3">
                            {column.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="text-sm text-steel transition-colors duration-150 hover:text-ice"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                ))
            }

            {/* Every live Sentinel — v1's footer listed only three and had
                silently dropped Transport. */}
            <nav aria-label={t.footer.platforms}>
                <h2
                    class="font-display text-xs font-semibold tracking-[0.18em] uppercase text-cyan-electric"
                >
                    {t.footer.platforms}
                </h2>
                <ul class="mt-5 space-y-3">
                    {
                        PLATFORMS.map((platform) =>
                            platform.url ? (
                                <li>
                                    <a
                                        href={platform.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-sm text-steel transition-colors duration-150 hover:text-ice"
                                    >
                                        {platform.name}
                                    </a>
                                </li>
                            ) : (
                                // Not deployed yet — listed, but never as a link
                                // that goes nowhere.
                                <li class="flex items-baseline gap-2 text-sm text-steel/60">
                                    {platform.name}
                                    <span class="text-[10px] tracking-wide uppercase">
                                        {t.home.platforms.statusSoon}
                                    </span>
                                </li>
                            )
                        )
                    }
                </ul>
            </nav>
        </div>

        <div
            class="mt-14 flex flex-col gap-6 border-t border-white/8 pt-8 sm:flex-row sm:items-center sm:justify-between"
        >
            <div class="space-y-1.5">
                <p class="text-sm text-steel">
                    © {year} {SITE.legalName}. {t.footer.rights}
                </p>
                <p class="text-xs text-steel/75">{t.footer.lopdp}</p>
            </div>

            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                <a
                    href={`mailto:${SITE.email}`}
                    class="text-sm text-steel transition-colors duration-150 hover:text-ice"
                >
                    {SITE.email}
                </a>
                <a
                    href={whatsappLink()}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-analytics="click_whatsapp"
                    data-source="footer"
                    class="text-sm text-steel transition-colors duration-150 hover:text-ice"
                >
                    WhatsApp
                </a>
                <a
                    href={route('privacidad', locale)}
                    class="text-sm text-steel transition-colors duration-150 hover:text-ice"
                >
                    {t.footer.privacy}
                </a>
            </div>
        </div>
    </div>
</footer>
