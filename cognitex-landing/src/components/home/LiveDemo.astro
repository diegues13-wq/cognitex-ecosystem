---
import Section from '~/components/ui/Section.astro';
import Card from '~/components/ui/Card.astro';
import Button from '~/components/ui/Button.astro';
import { route, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const demo = t.home.demo;

/*
 * Placeholder telemetry. The shape below is exactly what `/api/public/demo`
 * will return (spec §4.3.3), so wiring the real feed is a fetch call — the
 * markup and the axis maths do not change.
 */
const series = [
    3.1, 2.9, 2.8, 2.7, 2.8, 3.0, 3.6, 4.4, 5.2, 5.8, 6.1, 6.4, 6.2, 5.9, 6.3, 6.6, 6.1, 5.4, 4.8,
    4.3, 3.9, 3.6, 3.4, 3.2,
];
const vehicle = { km: 38, consumption: 9.4, stops: 6 };

const max = Math.max(...series);
const min = Math.min(...series);
const W = 600;
const H = 180;

// Map the series onto the viewBox. Padded 8px top and bottom so the stroke
// never clips.
const points = series.map((value, i) => {
    const x = (i / (series.length - 1)) * W;
    const y = H - 8 - ((value - min) / (max - min || 1)) * (H - 16);
    return [x, y] as const;
});

const line = points.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = `${line} L${W} ${H} L0 ${H} Z`;
const current = series.at(-1) ?? 0;
---

<Section
    kicker={demo.kicker}
    title={demo.title}
    description={demo.description}
    tone="deep"
    id="demo"
>
    <div class="mt-14 grid gap-6 lg:grid-cols-[1.6fr_1fr]">
        <Card variant="glass" class="p-7" data-reveal>
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                    <h3 class="font-display text-[length:var(--text-h3)]">{demo.power.title}</h3>
                    <p class="mt-1 text-sm text-steel">{demo.power.subtitle}</p>
                </div>
                <p class="flex items-baseline gap-1.5">
                    <span class="text-3xl font-semibold text-cyan-electric tabular">
                        {current.toFixed(1)}
                    </span>
                    <span class="text-sm text-steel">kW</span>
                </p>
            </div>

            <svg
                viewBox={`0 0 ${W} ${H}`}
                class="mt-6 w-full"
                role="img"
                aria-label={`${demo.power.title} — ${demo.power.subtitle}`}
                preserveAspectRatio="none"
            >
                <defs>
                    <linearGradient id="powerFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.28"></stop>
                        <stop offset="100%" stop-color="#00E5FF" stop-opacity="0"></stop>
                    </linearGradient>
                </defs>
                <path d={area} fill="url(#powerFill)"></path>
                <path
                    d={line}
                    fill="none"
                    stroke="#00E5FF"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"></path>
            </svg>

            <p class="mt-4 flex items-center gap-2 text-xs text-steel">
                <span class="inline-block size-1.5 rounded-full bg-green-ok" aria-hidden="true"
                ></span>
                {t.demoPage.note}
            </p>
        </Card>

        <Card variant="glass" class="flex flex-col p-7" data-reveal data-reveal-delay={120}>
            <h3 class="font-display text-[length:var(--text-h3)]">{demo.vehicle.title}</h3>
            <p class="mt-1 text-sm text-steel">{demo.vehicle.subtitle}</p>

            <dl class="mt-8 space-y-6">
                <div>
                    <dd class="text-3xl font-semibold text-cyan-electric tabular">{vehicle.km}</dd>
                    <dt class="mt-1 text-sm text-steel">km</dt>
                </div>
                <div>
                    <dd class="text-3xl font-semibold text-cyan-electric tabular">
                        {vehicle.consumption.toFixed(1)}
                    </dd>
                    <dt class="mt-1 text-sm text-steel">L/100 km</dt>
                </div>
                <div>
                    <dd class="text-3xl font-semibold text-cyan-electric tabular">
                        {vehicle.stops}
                    </dd>
                    <dt class="mt-1 text-sm text-steel">
                        {locale === 'es' ? 'paradas' : 'stops'}
                    </dt>
                </div>
            </dl>

            <div class="mt-auto pt-8">
                <Button href={route('demo', locale)} variant="ghost">{demo.cta}</Button>
            </div>
        </Card>
    </div>
</Section>
