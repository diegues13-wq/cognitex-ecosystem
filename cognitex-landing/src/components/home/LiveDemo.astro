---
import Section from '~/components/ui/Section.astro';
import Card from '~/components/ui/Card.astro';
import Button from '~/components/ui/Button.astro';
import { simulateOfficeSeries, simulateVehicleDay } from '~/lib/demo-fallback';
import { seriesToPaths } from '~/lib/demo-chart';
import { route, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const demo = t.home.demo;

/*
 * Server-rendered fallback so the widget is never empty on first paint and
 * degrades to something meaningful with JS disabled. It is marked
 * `simulated` until the client fetch says otherwise — the page must never
 * present a reference curve as a measurement.
 *
 * The client then hits /api/public/demo (same origin via the Firebase Hosting
 * rewrite to the demo-api Cloud Run service) and swaps in real values.
 */
const series = simulateOfficeSeries(24);
const vehicle = simulateVehicleDay();

const W = 600;
const H = 180;

// Drawn server-side with the same function the client uses, so the curve is
// present on first paint and with JS disabled, and does not jump when the
// fetch lands.
const paths = seriesToPaths(series, W, H);
---

<Section
    kicker={demo.kicker}
    title={demo.title}
    description={demo.description}
    tone="deep"
    id="demo"
>
    <div class="mt-14 grid gap-6 lg:grid-cols-[1.6fr_1fr]" data-demo-root>
        <Card variant="glass" class="p-7" data-reveal>
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                    <h3 class="font-display text-[length:var(--text-h3)]">{demo.power.title}</h3>
                    <p class="mt-1 text-sm text-steel">{demo.power.subtitle}</p>
                </div>
                <p class="flex items-baseline gap-1.5">
                    <span
                        class="text-3xl font-semibold text-cyan-electric tabular"
                        data-demo="office-current">{series.at(-1)?.kw.toFixed(1)}</span
                    >
                    <span class="text-sm text-steel">kW</span>
                </p>
            </div>

            <svg
                viewBox={`0 0 ${W} ${H}`}
                class="mt-6 w-full"
                role="img"
                aria-label={`${demo.power.title} — ${demo.power.subtitle}`}
                preserveAspectRatio="none"
                data-demo="office-chart"
                data-width={W}
                data-height={H}
            >
                <defs>
                    <linearGradient id="powerFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.28"></stop>
                        <stop offset="100%" stop-color="#00E5FF" stop-opacity="0"></stop>
                    </linearGradient>
                </defs>
                <path data-demo="office-area" d={paths.area} fill="url(#powerFill)"></path>
                <path
                    data-demo="office-line"
                    d={paths.line}
                    fill="none"
                    stroke="#00E5FF"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"></path>
            </svg>

            {/* Provenance badge — the whole point of the widget. */}
            <p
                class="mt-4 flex items-center gap-2 text-xs text-steel"
                data-demo="office-status"
                data-live-label={demo.statusLive}
                data-simulated-label={demo.statusSimulated}
                title={demo.statusHelp}
            >
                <span class="inline-block size-1.5 rounded-full bg-amber-warn" data-demo="office-dot"
                ></span>
                <span data-demo="office-status-text">{demo.statusSimulated}</span>
            </p>
        </Card>

        <Card variant="glass" class="flex flex-col p-7" data-reveal data-reveal-delay={120}>
            <h3 class="font-display text-[length:var(--text-h3)]">{demo.vehicle.title}</h3>
            <p class="mt-1 text-sm text-steel">{demo.vehicle.subtitle}</p>

            <dl class="mt-8 space-y-6">
                <div>
                    <dd
                        class="text-3xl font-semibold text-cyan-electric tabular"
                        data-demo="vehicle-km"
                    >
                        {vehicle.kmToday}
                    </dd>
                    <dt class="mt-1 text-sm text-steel">km</dt>
                </div>
                <div>
                    <dd
                        class="text-3xl font-semibold text-cyan-electric tabular"
                        data-demo="vehicle-consumption"
                    >
                        {vehicle.litersPer100km.toFixed(1)}
                    </dd>
                    <dt class="mt-1 text-sm text-steel">L/100 km</dt>
                </div>
                <div>
                    <dd
                        class="text-3xl font-semibold text-cyan-electric tabular"
                        data-demo="vehicle-stops"
                    >
                        {vehicle.stops}
                    </dd>
                    <dt class="mt-1 text-sm text-steel">
                        {locale === 'es' ? 'paradas' : 'stops'}
                    </dt>
                </div>
            </dl>

            <p
                class="mt-6 flex items-center gap-2 text-xs text-steel"
                data-demo="vehicle-status"
                data-live-label={demo.statusLive}
                data-simulated-label={demo.statusSimulated}
                title={demo.statusHelp}
            >
                <span
                    class="inline-block size-1.5 rounded-full bg-amber-warn"
                    data-demo="vehicle-dot"></span>
                <span data-demo="vehicle-status-text">{demo.statusSimulated}</span>
            </p>

            <div class="mt-auto pt-8">
                <Button href={route('demo', locale)} variant="ghost">{demo.cta}</Button>
            </div>
        </Card>
    </div>
</Section>

<script>
    import { seriesToPaths } from '~/lib/demo-chart';

    const root = document.querySelector('[data-demo-root]');

    if (root) {
        const pick = <T extends Element = HTMLElement>(name: string) =>
            root.querySelector<T>(`[data-demo="${name}"]`);

        const chart = pick<SVGSVGElement>('office-chart');
        const line = pick<SVGPathElement>('office-line');
        const area = pick<SVGPathElement>('office-area');

        const setStatus = (which: 'office' | 'vehicle', live: boolean) => {
            const wrapper = pick(`${which}-status`);
            const dot = pick(`${which}-dot`);
            const text = pick(`${which}-status-text`);
            if (!wrapper || !dot || !text) return;

            text.textContent = live
                ? (wrapper.dataset.liveLabel ?? '')
                : (wrapper.dataset.simulatedLabel ?? '');

            // Green for a real measurement, amber for a reference curve.
            dot.classList.toggle('bg-green-ok', live);
            dot.classList.toggle('bg-amber-warn', !live);
        };

        const render = (payload: any) => {
            const width = Number(chart?.dataset.width ?? 600);
            const height = Number(chart?.dataset.height ?? 180);

            const series: { at: number; kw: number }[] = payload.office?.series ?? [];
            if (series.length > 1 && line && area) {
                const paths = seriesToPaths(series, width, height);
                line.setAttribute('d', paths.line);
                area.setAttribute('d', paths.area);
            }

            const current = pick('office-current');
            if (current) current.textContent = Number(payload.office.currentKw).toFixed(1);

            const km = pick('vehicle-km');
            if (km) km.textContent = String(payload.vehicle.kmToday);

            const consumption = pick('vehicle-consumption');
            if (consumption)
                consumption.textContent = Number(payload.vehicle.litersPer100km).toFixed(1);

            const stops = pick('vehicle-stops');
            if (stops) stops.textContent = String(payload.vehicle.stops);

            setStatus('office', payload.office?.source === 'live');
            setStatus('vehicle', payload.vehicle?.source === 'live');
        };

        const load = async () => {
            try {
                const response = await fetch('/api/public/demo', { cache: 'no-store' });
                if (!response.ok) return;
                render(await response.json());
            } catch {
                // Offline or the service is down: keep the server-rendered
                // fallback, which is already labelled as simulated. Spec §8.7
                // requires the widgets to be offline-tolerant.
            }
        };

        load();
        // Matches the API's 30s cache; no point polling faster.
        setInterval(load, 30_000);
    }
</script>
