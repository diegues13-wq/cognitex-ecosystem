---
import Button from '~/components/ui/Button.astro';
import Stat from '~/components/ui/Stat.astro';
import { whatsappLink } from '~/config';
import { route, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const hero = t.home.hero;

// Placeholder telemetry until /api/public/demo exists. Values are rendered
// server-side so the figures are in the HTML; the live feed will replace them.
const counters = {
    power: 4.7,
    distance: 38,
    queries: 126,
};
---

<section
    class="relative flex min-h-[calc(100dvh-5rem)] items-center overflow-hidden bg-navy-900 py-16"
>
    {/* Hexagonal brand mesh. Pure inline SVG (~1KB) rather than a WebGL
        canvas — spec §4.8 caps initial JS at 150KB and a Three.js scene would
        consume the whole budget for a background.
        No negative z-index: the section paints its own background, which would
        cover anything behind it in the same stacking context. */}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <svg class="size-full opacity-[0.14]" data-hex-mesh>
            <defs>
                <pattern
                    id="hexmesh"
                    width="56"
                    height="97"
                    patternUnits="userSpaceOnUse"
                    patternTransform="scale(1.4)"
                >
                    <path
                        d="M28 0L56 16v32L28 64L0 48V16Z M28 64v33"
                        fill="none"
                        stroke="#00E5FF"
                        stroke-width="1"
                    ></path>
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#hexmesh)"></rect>
        </svg>

        {/* Cyan bloom anchored to the mark's optical centre. */}
        <div
            class="absolute top-1/4 -right-24 size-[36rem] rounded-full bg-[radial-gradient(circle,rgba(0,229,255,0.16),transparent_65%)] blur-2xl"
        >
        </div>
        <div
            class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-t from-navy-900 to-transparent"
        >
        </div>
    </div>

    <div class="container-page relative z-10">
        <p
            class="mb-6 inline-flex items-center gap-2 rounded-full border border-cyan-electric/25 px-4 py-1.5 text-xs font-semibold tracking-[0.16em] uppercase text-cyan-electric"
        >
            <span class="relative flex size-2">
                <span
                    class="absolute inline-flex size-full animate-ping rounded-full bg-green-ok opacity-70"
                ></span>
                <span class="relative inline-flex size-2 rounded-full bg-green-ok"></span>
            </span>
            {hero.eyebrow}
        </p>

        <h1 class="max-w-4xl text-[length:var(--text-hero)]">
            {hero.title}<br />
            <span class="text-cyan-electric text-glow">{hero.titleAccent}</span>
        </h1>

        <p class="mt-7 max-w-2xl text-[length:var(--text-lead)] leading-relaxed text-steel">
            {hero.lead}
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
            <Button
                href={whatsappLink()}
                size="lg"
                external
                data-analytics="click_whatsapp"
                data-source="hero"
            >
                {hero.ctaPrimary}
            </Button>
            <Button href={route('demo', locale)} variant="ghost" size="lg">
                {hero.ctaSecondary}
            </Button>
        </div>

        {/* Live counters from our own operation (spec §4.3.1). */}
        <div class="mt-16 border-t border-white/8 pt-8">
            <p class="mb-6 text-xs font-medium tracking-wide text-steel/80">
                {hero.liveNote}
            </p>
            <dl class="grid gap-8 sm:grid-cols-3">
                <Stat
                    value={counters.power}
                    decimals={1}
                    unit={hero.counters.power.unit}
                    label={hero.counters.power.label}
                />
                <Stat
                    value={counters.distance}
                    unit={hero.counters.distance.unit}
                    label={hero.counters.distance.label}
                />
                <Stat value={counters.queries} label={hero.counters.queries.label} />
            </dl>
        </div>
    </div>
</section>

<script>
    // Parallax drift on the mesh — a few lines instead of a 3D engine.
    // Disabled under reduced motion and on coarse pointers (no hover to track).
    const mesh = document.querySelector<SVGElement>('[data-hex-mesh]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches;

    if (mesh && !reduced && fine) {
        let frame = 0;

        window.addEventListener(
            'pointermove',
            (event) => {
                if (frame) return;
                frame = requestAnimationFrame(() => {
                    const x = (event.clientX / window.innerWidth - 0.5) * 18;
                    const y = (event.clientY / window.innerHeight - 0.5) * 18;
                    mesh.style.transform = `translate3d(${x}px, ${y}px, 0)`;
                    frame = 0;
                });
            },
            { passive: true }
        );

        mesh.style.transition = 'transform 600ms cubic-bezier(.16,1,.3,1)';
    }
</script>
