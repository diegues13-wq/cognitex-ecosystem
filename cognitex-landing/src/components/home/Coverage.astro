---
import Section from '~/components/ui/Section.astro';
import Card from '~/components/ui/Card.astro';
import { whatsappLink } from '~/config';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const cov = t.home.coverage;

/*
 * Google Maps with a dark Map ID is spec §4.3.6, but it needs a billed API key
 * and a configured Map ID. Until those exist this renders a static SVG of the
 * served provinces — no third-party request, no key in the bundle, and the
 * coverage answer still works. Swapping in the Maps island later replaces this
 * block only.
 */
const provinces = [
    { name: 'Pichincha', tone: 'primary', response: locale === 'es' ? 'Mismo día' : 'Same day' },
    { name: 'Guayas', tone: 'secondary', response: locale === 'es' ? '48 horas' : '48 hours' },
];
---

<Section kicker={cov.kicker} title={cov.title} description={cov.description} id="cobertura">
    <div class="mt-14 grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <Card class="p-7" data-reveal>
            <form id="coverage-form" class="space-y-4" novalidate>
                <label class="block">
                    <span class="text-sm font-medium text-steel">{cov.placeholder}</span>
                    <input
                        type="text"
                        id="coverage-input"
                        name="location"
                        autocomplete="address-level2"
                        placeholder="Quito, Sangolquí, Durán…"
                        class="mt-2 min-h-12 w-full rounded-xl border border-white/12 bg-navy-900 px-4 text-ice placeholder:text-steel/50 focus:border-cyan-electric focus:outline-none"
                    />
                </label>

                <button
                    type="submit"
                    class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-cyan-electric font-semibold text-navy-900 transition-colors duration-150 hover:bg-cyan-600"
                >
                    {locale === 'es' ? 'Comprobar' : 'Check'}
                </button>

                <p
                    id="coverage-answer"
                    class="hidden rounded-xl border border-cyan-electric/25 bg-cyan-electric/8 px-4 py-3 text-sm text-ice"
                    role="status"
                    aria-live="polite"
                    data-yes={cov.answerYes}
                    data-remote={cov.answerRemote}
                >
                </p>

                <a
                    href={whatsappLink()}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-analytics="click_whatsapp"
                    data-source="coverage"
                    class="block text-center text-sm font-semibold text-cyan-electric hover:underline"
                >
                    {cov.cta}
                </a>
            </form>
        </Card>

        <div data-reveal data-reveal-delay={120}>
            <svg
                viewBox="0 0 320 260"
                class="w-full"
                role="img"
                aria-label={cov.title}
                fill="none"
            >
                {/* Stylised Ecuador silhouette with the two served provinces. */}
                <path
                    d="M78 32 L150 20 L206 44 L236 92 L228 148 L250 186 L214 232 L150 244 L96 222 L62 176 L54 112 Z"
                    fill="#112240"
                    stroke="#8696A7"
                    stroke-width="1"
                    stroke-opacity="0.35"></path>

                <circle cx="146" cy="104" r="46" fill="#00E5FF" fill-opacity="0.14"></circle>
                <circle cx="146" cy="104" r="7" fill="#00E5FF"></circle>
                <circle cx="146" cy="104" r="14" stroke="#00E5FF" stroke-opacity="0.6">
                    <animate
                        attributeName="r"
                        values="10;26;10"
                        dur="3.2s"
                        repeatCount="indefinite"></animate>
                    <animate
                        attributeName="stroke-opacity"
                        values="0.6;0;0.6"
                        dur="3.2s"
                        repeatCount="indefinite"></animate>
                </circle>

                <circle cx="112" cy="176" r="30" fill="#00C896" fill-opacity="0.1"></circle>
                <circle cx="112" cy="176" r="5" fill="#00C896"></circle>

                <text x="160" y="100" fill="#F4F8FB" font-size="12" font-weight="600">Quito</text>
                <text x="160" y="115" fill="#8696A7" font-size="10">Pichincha</text>
                <text x="126" y="180" fill="#F4F8FB" font-size="11" font-weight="600">Guayas</text>
            </svg>

            <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
                {
                    provinces.map((p) => (
                        <li class="flex items-center gap-2.5 text-sm">
                            <span
                                class={`inline-block size-2.5 rounded-full ${p.tone === 'primary' ? 'bg-cyan-electric' : 'bg-green-ok'}`}
                                aria-hidden="true"
                            />
                            <span class="font-medium">{p.name}</span>
                            <span class="text-steel">· {p.response}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</Section>

<script>
    // Provinces we cover in person. Anything else gets the honest "remote"
    // answer rather than a fake yes.
    const SAME_DAY = ['pichincha', 'quito', 'sangolqui', 'cumbaya', 'machachi', 'cayambe'];
    const WITHIN_48H = ['guayas', 'guayaquil', 'duran', 'samborondon', 'milagro'];

    const form = document.getElementById('coverage-form') as HTMLFormElement | null;
    const input = document.getElementById('coverage-input') as HTMLInputElement | null;
    const answer = document.getElementById('coverage-answer');

    if (form && input && answer) {
        // Strip diacritics so "Sangolquí" matches "sangolqui".
        const normalise = (value: string) =>
            value
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            const query = normalise(input.value);
            if (!query) return;

            const covered =
                SAME_DAY.some((p) => query.includes(p)) || WITHIN_48H.some((p) => query.includes(p));

            answer.textContent = covered
                ? (answer.dataset.yes ?? '')
                : (answer.dataset.remote ?? '');
            answer.classList.remove('hidden');

            document.dispatchEvent(
                new CustomEvent('analytics', { detail: { event: 'map_search', covered } })
            );
        });
    }
</script>
