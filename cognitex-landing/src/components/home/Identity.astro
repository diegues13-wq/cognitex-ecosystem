---
import Section from '~/components/ui/Section.astro';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const id = t.home.identity;

/*
 * The three layers Cognitex actually sells, stacked the way they stack in
 * reality: signal enters at the edge, persists in the cloud, and is acted on
 * by the models. v1 drew this as three isometric plates with a data beam; the
 * idea was right, so it stays — as a vertical stack that survives a phone
 * screen, with the beam as a gradient rail rather than a transform that
 * breaks under narrow viewports.
 */
const layers = [
    { n: '01', ...id.pillars.edge },
    { n: '02', ...id.pillars.cloud },
    { n: '03', ...id.pillars.ai },
];
---

<Section kicker={id.kicker} tone="deep" id="quienes-somos">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
        <div data-reveal>
            <h2 class="max-w-2xl text-[length:var(--text-h2)]">{id.title}</h2>

            <div class="mt-8 space-y-5 text-[length:var(--text-lead)] leading-relaxed text-steel">
                {id.body.map((paragraph: string) => <p>{paragraph}</p>)}
            </div>

            <p
                class="mt-10 border-l-2 border-cyan-electric/45 bg-cyan-electric/[0.04] py-4 pl-5 text-ice/90"
            >
                {id.commitment}
            </p>
        </div>

        {/* The stack. `h-fit` matters: as a grid child it would otherwise
            stretch to the taller left column and the beam would run on past
            the last layer into empty space. */}
        <ol class="relative flex h-fit flex-col gap-4" data-reveal data-reveal-delay={140}>
            {/* The beam that ties the layers together. */}
            <span
                class="absolute top-6 bottom-6 left-[27px] w-px bg-gradient-to-b from-cyan-electric/60 via-cyan-electric/25 to-transparent"
                aria-hidden="true"></span>

            {
                layers.map((layer, i) => (
                    <li
                        class="group relative flex gap-5 rounded-[20px] border border-white/8 bg-navy-900/60 p-5 transition-[border-color,transform] duration-300 ease-[cubic-bezier(.16,1,.3,1)] hover:-translate-y-0.5 hover:border-cyan-electric/35"
                        data-reveal
                        data-reveal-delay={180 + i * 90}
                    >
                        <span
                            class="relative z-10 flex size-14 shrink-0 items-center justify-center rounded-full border border-cyan-electric/30 bg-navy-deep font-mono text-xs font-semibold text-cyan-electric"
                            aria-hidden="true"
                        >
                            {layer.n}
                        </span>

                        <div>
                            <h3 class="font-display text-[length:var(--text-h3)]">{layer.title}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-steel">{layer.body}</p>
                        </div>
                    </li>
                ))
            }
        </ol>
    </div>
</Section>
