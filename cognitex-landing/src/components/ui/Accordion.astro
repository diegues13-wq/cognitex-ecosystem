---
interface Props {
    items: readonly { readonly q: string; readonly a: string }[];
    class?: string;
}

const { items, class: className = '' } = Astro.props;
---

{/*
  Native <details>/<summary>: keyboard operable, screen-reader announced and
  fully functional with JS disabled — no ARIA bookkeeping to get wrong.
  `name` makes them mutually exclusive (one open at a time) natively.
*/}
<div class={`divide-y divide-white/8 border-y border-white/8 ${className}`}>
    {
        items.map((item) => (
            <details name="faq" class="group">
                <summary
                    class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-lg font-medium transition-colors duration-150 hover:text-cyan-electric [&::-webkit-details-marker]:hidden"
                >
                    <span>{item.q}</span>
                    <svg
                        class="size-5 shrink-0 text-cyan-electric transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-open:rotate-45"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <path d="M10 4v12M4 10h12" />
                    </svg>
                </summary>
                <div class="pb-6 text-steel leading-relaxed max-w-2xl">{item.a}</div>
            </details>
        ))
    }
</div>
