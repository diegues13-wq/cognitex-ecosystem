---
interface Props {
    /** `glass` is reserved for calculators and live-demo widgets (spec §2). */
    variant?: 'glass' | 'solid' | 'outline';
    href?: string;
    class?: string;
    /** Container query context, so cards adapt to their cell, not the viewport. */
    contained?: boolean;
}

const { variant = 'solid', href, class: className = '', contained = true } = Astro.props;

const variants = {
    glass: 'glass',
    solid: 'rounded-[20px] border border-white/8 bg-navy-800/60',
    outline: 'rounded-[20px] border border-cyan-electric/20 bg-transparent',
};

const interactive = href
    ? 'transition-[transform,border-color,box-shadow] duration-300 ease-[cubic-bezier(.16,1,.3,1)] ' +
      'hover:-translate-y-1 hover:border-cyan-electric/45 ' +
      'hover:shadow-[0_18px_50px_-20px_rgba(0,229,255,0.35)]'
    : '';

const classes = `@container ${variants[variant]} ${interactive} ${className}`;
const Tag = href ? 'a' : 'div';
---

<Tag
    class={contained ? classes : classes.replace('@container ', '')}
    {...href ? { href } : {}}
>
    <slot />
</Tag>
