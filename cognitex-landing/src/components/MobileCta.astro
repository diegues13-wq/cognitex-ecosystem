---
import { whatsappLink } from '~/config';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/*
  Sticky conversion bar on mobile only (spec §4.4). It appears once the hero
  has scrolled past, so it never covers the primary CTA.
  pb-[env(safe-area-inset-bottom)] keeps it clear of the iOS home indicator.
*/}
<div
    id="mobile-cta"
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-cyan-electric/20 bg-navy-900/95 backdrop-blur-lg transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] pb-[env(safe-area-inset-bottom)] lg:hidden"
>
    <div class="container-page py-3">
        <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="click_whatsapp"
            data-source="mobile_bar"
            class="flex min-h-12 w-full items-center justify-center rounded-xl bg-cyan-electric font-semibold text-navy-900"
        >
            {t.common.mobileCta}
        </a>
    </div>
</div>

<script>
    const bar = document.getElementById('mobile-cta');

    if (bar) {
        const reveal = () => {
            const past = window.scrollY > window.innerHeight * 0.6;
            bar.classList.toggle('translate-y-full', !past);
        };

        reveal();
        window.addEventListener('scroll', reveal, { passive: true });
    }
</script>
