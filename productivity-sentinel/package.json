{
    "name": "productivity-sentinel",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "description": "Last Planner console: daily failure log, weekly plan compliance, constraints and root-cause analysis",
    "scripts": {
        "dev": "vite --port 5178",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --port 5178",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@cognitex/auth": "*",
        "@cognitex/data": "*",
        "@cognitex/theme": "*",
        "@cognitex/ui": "*",
        "lucide-react": "^0.563.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@cognitex/config": "*",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.3",
        "vitest": "^4.1.10"
    }
}
