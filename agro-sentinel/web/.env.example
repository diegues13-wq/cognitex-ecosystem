# ── Firebase ──────────────────────────────────────────────────────────────────
# Copy to .env and fill in from Firebase Console → Project settings → Your apps.
#
# Leave VITE_FIREBASE_API_KEY empty and the console runs unconfigured: open
# demo login, generated readings, and a "Datos simulados" badge on every view.
# It never silently presents generated numbers as measurement.
#
# These six are also the six `--build-arg` values that deploy-agro.yaml passes
# into the image. Until 2026-08 the workflow passed none and the Dockerfile
# declared none, so the deployed console was permanently a click-through demo
# no matter what the Firebase project contained.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The console reads Firestore directly through the Web SDK; there is no REST
# API to point at. VITE_SENSOR_API_URL and VITE_AI_FUNCTION_URL are gone: they
# named /live and /history endpoints that terraform/main.tf has never created,
# so setting VITE_USE_MOCK=false produced a console that fetched 404s.
# See ../PIPELINE_STATUS.md.
