# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Copy to .env and fill in from Firebase Console → Project settings → Your apps.
#
# Leave VITE_FIREBASE_API_KEY empty and the console runs unconfigured: open
# demo login, generated data, and a "Datos simulados" badge on every view.
#
# One consequence is specific to this console: the AI assistant needs a real
# session, because the server requires a Firebase ID token before it spends
# anything on Vertex AI. In demo mode the assistant says so instead of failing
# obscurely; every other section works.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Without it the CCO map falls back to a projected SVG that still
# plots every train in the right place.
VITE_GOOGLE_MAPS_API_KEY=

# ── API (api/, Node) ──────────────────────────────────────────────────────────
# Not Vite variables: these are read by the Express process at runtime and are
# never built into the bundle.
#
# Firestore uses Application Default Credentials on Cloud Run. Locally, either
# set GOOGLE_APPLICATION_CREDENTIALS to a service-account key or run the
# emulator with FIRESTORE_EMULATOR_HOST=localhost:8090.
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project
GEMINI_REGION=us-central1

# Extra browser origins allowed to call /api, comma separated. The site
# origins and the dev server are already allowed; this is for previews.
ALLOWED_ORIGINS=

# Required before POST /api/admin/reseed will do anything. Unset means the
# endpoint refuses every request.
ADMIN_KEY=
